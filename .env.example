# Copy to .env and fill in. Turn on Discord Developer Mode (User Settings > Advanced)
# to copy server, role and channel IDs with right-click > Copy ID.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Members need at least one of these roles to search or request (comma-separated).
REQUEST_ROLE_IDS=
# Optional: only answer in these channels (comma-separated). Empty = any channel.
ALLOWED_CHANNEL_IDS=
# Post "Request Now Available" in a channel when a request finishes downloading.
NOTIFY_AVAILABLE=false
NOTIFY_CHANNEL_ID=

# --- Lidarr ---
# Address of Lidarr as seen from the bot, e.g. the LXC's LAN IP.
LIDARR_URL=http://192.168.1.50:8686
# Lidarr > Settings > General > Security > API Key
LIDARR_API_KEY=
# Name or ID. Empty = the root folder's default quality profile.
LIDARR_QUALITY_PROFILE=
LIDARR_METADATA_PROFILE=Standard
# Empty = Lidarr's first root folder.
LIDARR_ROOT_FOLDER=
# What to monitor when someone requests a whole artist:
# all | future | missing | existing | first | latest | none
ARTIST_MONITOR=all

# --- Other ---
DATABASE_PATH=data/requests.db
# How often to re-read the Lidarr library (finished downloads are also
# picked up as soon as they leave the download queue).
LIBRARY_REFRESH_SECONDS=300
QUEUE_REFRESH_SECONDS=60
LOG_LEVEL=INFO
